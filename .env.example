# ANMAT Trazabilidad - Configuración de Entorno
# Copiar a .env y completar con valores reales

# --- ANMAT WebService ---
# WSDL URL para producción:
ANMAT_WSDL=https://trazabilidad.pami.org.ar:9050/trazamed.WebService?wsdl
# Para desarrollo/pruebas:
#ANMAT_WSDL=https://servicios.pami.org.ar/trazamed.WebService?wsdl

# Credenciales de aplicación ANMAT (usuario y contraseña asignados por ANMAT)
ANMAT_USUARIO=
ANMAT_PASSWORD=

# NOTA: Las credenciales WSSE de transporte son fijas (testwservice / testwservicepsw)
# y están hardcodeadas en anmat_reporter.py según especificación Disp. 3683/11

# --- Firebird Database ---
FIREBIRD_HOST=localhost
FIREBIRD_PORT=3050
FIREBIRD_DB=siia
FIREBIRD_USER=TRAZA_USER
FIREBIRD_PASSWORD=
FIREBIRD_ROLE=USUARIO

# --- Scheduler ---
# Intervalo del reporte automático en minutos
SCHEDULER_INTERVAL_MINUTES=15

# --- Timeouts (segundos) ---
ANMAT_TIMEOUT=15
FIREBIRD_CONNECT_TIMEOUT=8
